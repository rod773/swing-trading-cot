//@version=6
indicator(
     title="COT Commercial Net"
     , shorttitle="COT Net"
     , format=format.percent
     , precision=1
     , timeframe=""
     , timeframe_gaps=true
     )

import TradingView/LibraryCOT/4 as cot

// ─── Based on Larry Williams' COT Index methodology ───────────────────────
// Commercial net = Commercial Longs − Commercial Shorts
// %-rank of net within a rolling window → COT Index
//
//   High % → commercials are net long (bullish signal)
//   Low  % → commercials are net short (bearish signal)
// ───────────────────────────────────────────────────────────────────────────

// ─── Inputs ────────────────────────────────────────────────────────────────
includeOptions = input.bool(false,    "Include Options")
lookback      = input.int(3,   "Lookback Range (years)", minval=1)
obLevel       = input.int(80,  "Overbought Level",       minval=1)
osLevel       = input.int(20,  "Oversold Level",         minval=1)

// ─── CFTC Code (auto from chart symbol) ────────────────────────────────────
cftcCode = cot.convertRootToCOTCode("Auto")

// ─── Commercial Positions ──────────────────────────────────────────────────
comLong  = request.security(cot.COTTickerid("Legacy", cftcCode, includeOptions, "Traders Commercial", "Long", "All"), "W", close)
comShort = request.security(cot.COTTickerid("Legacy", cftcCode, includeOptions, "Traders Commercial", "Short", "All"), "W", close)

net = comLong - comShort

// ─── %-Rank within lookback window (COT Index) ────────────────────────────
bars = lookback * 52

hi = ta.highest(net, bars)
lo = ta.lowest(net, bars)
rng = hi - lo

pct = rng > 0 ? (net - lo) / rng * 100 : 50

// ─── Visuals ───────────────────────────────────────────────────────────────
hline(50,  "Midline",         color=color.gray,   linestyle=hline.style_dotted)
hline(obLevel, "Overbought",  color=color.maroon, linestyle=hline.style_dashed)
hline(osLevel, "Oversold",    color=color.green,  linestyle=hline.style_dashed)

color pColor = pct > obLevel ? color.maroon : pct < osLevel ? color.green : color.blue
plot(pct, "COT Index", pColor, linewidth=2)

fill(plot(obLevel, display=display.none), plot(100, display=display.none),
  color.new(color.maroon, 85), title="Overbought Zone")
fill(plot(osLevel, display=display.none), plot(0, display=display.none),
  color.new(color.green, 85), title="Oversold Zone")
